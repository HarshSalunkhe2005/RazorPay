# Server-side only - never expose to the client.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional - test-mode keys from your Razorpay dashboard (Settings > API Keys, switch to
# Test Mode first). When set, retry links are real Razorpay Payment Links API responses
# instead of a constructed demo URL. The app works fine without these - it falls back to
# the demo link automatically, see src/lib/razorpay.ts.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
